{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:sync": "node scripts/sync-dev-db.ts",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo run lint && pnpm run lint:root",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo run lint:fix && pnpm run lint:root --fix",
		"lint:github": "turbo lint:github",
		"lint:root": "oxlint --ignore-pattern packages",
		"prepare": "lefthook install",
		"test": "turbo test",
		"test:affected": "turbo test --affected",
		"test:coverage": "turbo test:coverage",
		"test:e2e": "turbo test:e2e",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@mheob/commitlint-config": "^2.0.7",
		"@mheob/oxfmt-config": "^1.3.3",
		"@mheob/oxlint-config": "^4.0.1",
		"@mheob/tsconfig": "^3.0.2",
		"@types/node": "^24.13.6",
		"@vitest/coverage-v8": "^4.1.11",
		"cve-lite-cli": "^1.37.0",
		"czg": "^1.14.0",
		"lefthook": "^2.1.14",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"sanity": "^6.16.0",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.11.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "^24.20.0",
		"pnpm": "^11.24.0 || ^12.0.0"
	},
	"packageManager": "pnpm@12.5.0"
}
