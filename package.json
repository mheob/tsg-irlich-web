{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo lint",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo lint:fix",
		"lint:github": "turbo lint:github",
		"lint:root": "oxlint",
		"lint:root:fix": "oxlint --fix",
		"prepare": "husky",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@mheob/commitlint-config": "^2.0.1",
		"@mheob/oxfmt-config": "^1.2.0",
		"@mheob/oxlint-config": "^2.2.0",
		"@types/bun": "^1.3.12",
		"@types/node": "^24.12.2",
		"czg": "^1.12.0",
		"eslint-plugin-better-tailwindcss": "^4.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"tailwindcss": "^4.2.2",
		"turbo": "^2.9.6",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"glob": "^10.5.0 || >=11.1.0",
		"js-yaml": "^3.14.2 || >=4.1.1",
		"minimatch": "^10.2.1",
		"prismjs": ">=1.30.0",
		"undici": ">=7.10.0 <8.0.0"
	},
	"lint-staged": {
		"*": [
			"oxfmt --no-error-on-unmatched-pattern",
			"oxlint --fix"
		]
	},
	"engines": {
		"bun": "^1.3.11",
		"node": "^24.14.1"
	},
	"packageManager": "bun@1.3.11"
}
