{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:sync": "node scripts/sync-dev-db.ts",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo run lint && pnpm run lint:root",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo run lint:fix && pnpm run lint:root --fix",
		"lint:github": "turbo lint:github",
		"lint:root": "oxlint --ignore-pattern packages",
		"prepare": "lefthook install",
		"test": "turbo test",
		"test:affected": "turbo test --affected",
		"test:coverage": "turbo test:coverage",
		"test:e2e": "turbo test:e2e",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@mheob/commitlint-config": "^2.0.6",
		"@mheob/oxfmt-config": "^1.3.2",
		"@mheob/oxlint-config": "^3.0.1",
		"@mheob/tsconfig": "^3.0.2",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.11",
		"cve-lite-cli": "^1.31.0",
		"czg": "^1.14.0",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"sanity": "^6.11.0",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "^24.20.0",
		"pnpm": "^11.24.0"
	},
	"packageManager": "pnpm@11.25.0"
}
