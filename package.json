{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo run lint && bun run lint:root",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo run lint:fix && bun run lint:root -- --fix",
		"lint:github": "turbo lint:github",
		"lint:root": "oxlint --ignore-pattern packages",
		"prepare": "lefthook install",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@mheob/commitlint-config": "^2.0.5",
		"@mheob/oxfmt-config": "^1.3.1",
		"@mheob/oxlint-config": "^3.0.0",
		"@mheob/tsconfig": "^3.0.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.0",
		"cve-lite-cli": "^1.28.0",
		"czg": "^1.13.1",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"sanity": "^6.8.0",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.10.8",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"js-yaml": ">=4.3.1",
		"smol-toml": ">=1.6.1",
		"undici": ">=7.29.0",
		"uuid": ">=11.1.1"
	},
	"engines": {
		"bun": "^1.3.14",
		"node": "^24.19.0"
	},
	"packageManager": "bun@1.3.14"
}
