{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:sync": "node scripts/sync-dev-db.ts",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "turbo run lint && pnpm run lint:root",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo run lint:fix && pnpm run lint:root --fix",
		"lint:github": "turbo lint:github",
		"lint:root": "vp lint --ignore-pattern packages",
		"prepare": "lefthook install",
		"test": "turbo test",
		"test:affected": "turbo test --affected",
		"test:coverage": "turbo test:coverage",
		"test:e2e": "turbo test:e2e",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@mheob/commitlint-config": "catalog:",
		"@mheob/oxfmt-config": "catalog:",
		"@mheob/oxlint-config": "catalog:",
		"@mheob/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"cve-lite-cli": "catalog:",
		"czg": "catalog:",
		"eslint-plugin-better-tailwindcss": "catalog:",
		"lefthook": "catalog:",
		"sanity": "catalog:",
		"tailwindcss": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "^24.20.0",
		"pnpm": "^11.24.0 || ^12.0.0"
	},
	"packageManager": "pnpm@12.7.0"
}
