{
	"name": "@tsgi-web/root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"build:affected": "turbo build --affected",
		"dev": "turbo dev",
		"dev:email": "turbo dev:email",
		"extract-types": "turbo extract-types",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo lint",
		"lint:affected": "turbo lint --affected",
		"lint:affected:github": "turbo lint:github --affected",
		"lint:fix": "turbo lint:fix",
		"lint:github": "turbo lint:github",
		"lint:root": "oxlint",
		"lint:root:fix": "oxlint --fix",
		"prepare": "lefthook install",
		"typecheck": "turbo typecheck",
		"typegen:routes": "turbo typegen:routes",
		"typegen:sanity": "turbo typegen:sanity"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@mheob/commitlint-config": "^2.0.3",
		"@mheob/oxfmt-config": "^1.2.2",
		"@mheob/oxlint-config": "^2.3.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.13.3",
		"czg": "^1.13.1",
		"eslint-plugin-better-tailwindcss": "^4.6.1",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.59.0",
		"oxlint": "^1.74.0",
		"sanity": "^5.20.0",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"glob": ">=11.1.0",
		"js-yaml": ">=4.1.1",
		"minimatch": ">=10.2.1",
		"prismjs": ">=1.30.0",
		"undici": ">=7.10.0 <8.0.0"
	},
	"engines": {
		"bun": "^1.3.14",
		"node": "^24.18.0"
	},
	"packageManager": "bun@1.3.14"
}
