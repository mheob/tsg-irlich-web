{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"e2e:browsers": "playwright install --with-deps chromium webkit",
		"e2e:record": "E2E_RECORD=1 playwright test --project=chromium",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"lint:github": "vp lint --format=github",
		"start": "next start",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:preview": "playwright test --config playwright.preview.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:visual": "playwright test --grep @visual",
		"test:e2e:visual:update": "./scripts/update-screenshots.sh",
		"test:lighthouse": "lhci autorun",
		"test:watch": "vp test",
		"typecheck": "tsc --noEmit --incremental false",
		"typegen:routes": "next typegen && tsc --noEmit",
		"typegen:sanity": "sanity typegen generate"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@hookform/resolvers": "catalog:",
		"@icons-pack/react-simple-icons": "catalog:",
		"@sanity/client": "catalog:",
		"@sanity/image-url": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tsgi-web/email": "workspace:*",
		"@tsgi-web/pdf-pages": "workspace:*",
		"@tsgi-web/shared": "workspace:*",
		"@vercel/analytics": "catalog:",
		"@vercel/speed-insights": "catalog:",
		"class-variance-authority": "catalog:",
		"lucide-react": "catalog:",
		"motion": "catalog:",
		"next": "catalog:",
		"next-safe-action": "catalog:",
		"next-sanity": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-hook-form": "catalog:",
		"resend": "catalog:",
		"server-only": "catalog:",
		"tailwindcss": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "catalog:",
		"@lhci/cli": "catalog:",
		"@playwright/test": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
