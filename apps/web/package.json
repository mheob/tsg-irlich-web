		"msw": "catalog:",
		"postcss": "catalog:",
		"postcss-load-config": "catalog:",
		"sanity": "catalog:",
		"schema-dts": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
