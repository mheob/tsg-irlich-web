# Environment for the end-to-end suite.
#
# Every outbound call is intercepted by MSW (see `e2e/mocks/preload.ts`), so none of these secrets
# is real and none of them has to exist in CI. Only the two public Sanity values are the real ones,
# because the recorded fixtures are keyed by the URL they appear in.

NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"
NEXT_PUBLIC_SANITY_DATASET="development"
NEXT_PUBLIC_SANITY_PROJECT_ID="j4rxwl5m"
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

CLEVERREACH_CLIENT_ID="e2e-client-id"
CLEVERREACH_CLIENT_SECRET="e2e-client-secret"
CLEVERREACH_FORM_ID="e2e-form-id"
CLEVERREACH_LIST_ID="e2e-list-id"

LINEAR_API_KEY="e2e-linear-key"
LINEAR_ASSIGNEE_ID="e2e-assignee"
LINEAR_LABEL_ID="e2e-label"
LINEAR_TEAM_ID="e2e-team"

RESEND_API_KEY="e2e-resend-key"
SANITY_API_READ_TOKEN="e2e-read-token"
SANITY_REVALIDATE_SECRET="e2e-revalidate-secret"
