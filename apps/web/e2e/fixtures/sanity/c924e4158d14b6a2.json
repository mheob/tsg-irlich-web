								{
									"_key": "5c6cd6a574b4",
									"_type": "span",
									"marks": [],
									"text": "Den Schlusspunkt setzte erneut "
								},
								{
									"_key": "09d08e5573ae",
									"_type": "span",
									"marks": ["strong"],
									"text": "Dennis Kari"
								},
								{
									"_key": "bd3fe27f16fb",
									"_type": "span",
									"marks": [],
									"text": ". Mit seinem zweiten Treffer des Tages sorgte der junge Stürmer für den "
								},
								{
									"_key": "dac5913154d6",
									"_type": "span",
									"marks": ["strong"],
									"text": "4:1-Endstand"
