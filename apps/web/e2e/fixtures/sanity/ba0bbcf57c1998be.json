								{
									"_key": "6c6a336b97aa",
									"_type": "span",
									"marks": ["strong"],
									"text": "Niklas Kindler"
								},
								{
									"_key": "7f19c5ae4fa8",
									"_type": "span",
									"marks": [],
									"text": " vor dem Oberbieberer Tor auf und verwandelte sicher ins linke untere Eck. Auch danach blieb die TSG spielbestimmend und hätte ihre Führung bereits vor der Pause ausbauen können. Mehrere gute Möglichkeiten blieben jedoch ungenutzt, sodass es mit dem knappen 1:0 in die Kabinen ging."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
