							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "53dfc3d393b8",
							"_type": "block",
							"children": [
								{
									"_key": "4ee24ed3e971",
									"_type": "span",
									"marks": [],
									"text": "Trainer "
								},
								{
									"_key": "e456da343d80",
									"_type": "span",
									"marks": ["strong"],
									"text": "Michael Lehmann"
								},
								{
									"_key": "ca35f577abdb",
									"_type": "span",
									"marks": [],
									"text": " zeigte sich mit dem Auftritt seiner Mannschaft zufrieden, sah aber weiterhin Verbesserungspotenzial:"
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "8b7ec1c26ce3",
							"_type": "block",
							"children": [
								{
									"_key": "b1ba234bc131",
									"_type": "span",
									"marks": [],
									"text": "„Wie schon in Rengsdorf waren unsere Tore sehr schön herausgespielt. Allerdings müssen wir aus unseren vielen Möglichkeiten noch mehr Treffer machen – daran werden wir weiter arbeiten. Die Mentalität der Mannschaft stimmt absolut. Wir haben unsere ersten beiden Ligaspiele gewonnen und wollen diesen Weg in den kommenden Partien natürlich fortsetzen.“"
								}
							],
							"markDefs": [],
							"style": "blockquote"
						},
						{
							"_key": "33873ea47811",
							"_type": "block",
							"children": [
								{
									"_key": "9a89e88eada0",
									"_type": "span",
									"marks": [],
									"text": "Nach dem 3:2-Auswärtssieg in Rengsdorf hat die TSG nun auch das erste Liga-Heimspiel für sich entschieden. Mit sechs Punkten aus den ersten beiden Begegnungen ist der Start in die neue Saison gelungen."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
