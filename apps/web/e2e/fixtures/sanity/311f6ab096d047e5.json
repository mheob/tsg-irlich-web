						{
							"_key": "efc0ee206531",
							"_type": "block",
							"children": [
								{
									"_key": "75c9d12f948c",
									"_type": "span",
									"marks": [],
									"text": "Ein abwechslungsreicher Abschluss "
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "b58aa27f19a2",
							"_type": "block",
							"children": [
								{
									"_key": "442d282ac726",
									"_type": "span",
									"marks": [],
									"text": "Am Montagvormittag bildete die "
								},
								{
									"_key": "687823680e39",
									"_type": "span",
									"marks": ["40a61b75576e"],
									"text": "Wilhelma"
								},
								{
									"_key": "af4811ccf5ef",
									"_type": "span",
									"marks": [],
									"text": " den Abschluss der gemeinsamen Reise. Der zoologisch-botanische Garten mit seinen zahlreichen Tieren, Pflanzen und historischen Gebäuden bot noch einmal abwechslungsreiche Eindrücke, bevor die Heimreise anstand."
								}
							],
							"markDefs": [
								{
									"_key": "40a61b75576e",
									"_type": "externalLink",
									"href": "https://www.wilhelma.de/"
								}
							],
							"style": "normal"
						},
						{
							"_key": "4a0315601ced",
							"_type": "block",
							"children": [
								{
									"_key": "64ae0d911438",
									"_type": "span",
									"marks": [],
									"text": "Doch zuvor wartete noch ein letzter Stuttgarter Programmpunkt: Stuttgart 21. Die Jedermänner konnten die Dimensionen des Großprojekts bestaunen – und gleichzeitig ganz praktisch erfahren, welche Auswirkungen die aktuelle Baustellensituation auf Reisende hat. Die teilweise langen Wege zwischen U-Bahn und Bahnsteigen sorgten dafür, dass auch am letzten Tag der sportliche Anteil der Reise nicht zu kurz kam."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "201a6436c311",
							"_type": "block",
							"children": [
								{
									"_key": "d25f04bcd76a",
									"_type": "span",
									"marks": [],
									"text": "Am Nachmittag ging es schließlich wieder mit der Bahn zurück nach Neuwied. Nach vier ereignisreichen Tagen waren sich alle einig: Die gemeinsame Tour war wieder ein voller Erfolg und hat jede Menge Spaß gemacht."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "4cd1d1a72a5e",
							"_type": "block",
							"children": [
								{
									"_key": "63530335a9b0",
									"_type": "span",
									"marks": [],
									"text": "Kultur, Autos, Tiere, sommerliche Hitze, Biergarten, Planetarium, lange Fußwege und vor allem eine gesellige Gemeinschaft – Stuttgart hatte für die Jedermänner einiges zu bieten."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "bc6a808f650b",
					"_type": "blockContent",
					"text": [
						{
							"_key": "58c66d0d1f17",
							"_type": "block",
							"children": [
								{
									"_key": "bf55256eb4b2",
									"_type": "span",
									"marks": [],
									"text": "Bleibt eigentlich nur noch eine Frage: Wohin geht es 2027? Die Planungen dürfen sicherlich schon bald beginnen."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "bcbafd8a23e3",
							"_type": "block",
							"children": [
								{
									"_key": "711fdeac4ba3",
									"_type": "span",
									"marks": [],
									"text": "Nach der Tour ist vor dem Training"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "e7eff5345713",
							"_type": "block",
							"children": [
								{
									"_key": "cb73a471a703",
									"_type": "span",
									"marks": [],
									"text": "Bis dahin wird aber erst einmal wieder gemeinsam trainiert. Die "
								},
								{
									"_key": "6811f3bd118d",
									"_type": "span",
									"marks": ["948fdf34e581"],
									"text": "Jedermänner"
								},
								{
									"_key": "2932d48582aa",
									"_type": "span",
									"marks": [],
									"text": " treffen sich jeden Freitag um 20:00 Uhr in der Sporthalle der Robert-Krups-Schule."
								}
							],
							"markDefs": [
								{
									"_key": "948fdf34e581",
									"_type": "internalLink",
									"link": {
										"_ref": "99a99cb7-a09c-4e81-9ace-453367c48b1f",
										"_type": "reference"
									},
									"target": {
										"_type": "group.other-sports",
										"category": null,
										"slug": "jedermaenner"
									}
								}
							],
							"style": "normal"
						},
						{
							"_key": "ce29c7329546",
							"_type": "block",
							"children": [
								{
									"_key": "46b621ffd991",
									"_type": "span",
									"marks": [],
									"text": "Wer Lust auf Bewegung, Sport und eine gesellige Gemeinschaft hat, ist jederzeit herzlich willkommen. Neue Gesichter sind gerne gesehen – einfach vorbeikommen und mitmachen! "
								}
							],
