					"text": [
						{
							"_key": "38c6cbbed0af",
							"_type": "block",
							"children": [
								{
									"_key": "dc3a84884ac9",
									"_type": "span",
									"marks": ["strong", "em"],
									"text": "Auch in diesem Jahr ging es für die Jedermänner der TSG Irlich wieder gemeinsam auf Tour! Vom 19. bis 22. Juni 2026 führte die diesjährige Reise nach Stuttgart. Vier Tage lang standen Kultur, Sport, Automobilgeschichte, gemeinsame Erlebnisse und natürlich jede Menge Geselligkeit auf dem Programm."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "14949f321a3f",
							"_type": "block",
							"children": [
								{
									"_key": "91d267a16028",
									"_type": "span",
									"marks": [],
									"text": "Bereits die Anreise sorgte für gute Stimmung: Mit der Deutschen Bahn ging es planmäßig und völlig problemlos von Neuwied nach Stuttgart – ein gelungener Start in das gemeinsame Wochenende."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "e588383e555e",
					"_type": "blockContent",
					"text": [
						{
							"_key": "c236d9f0d065",
							"_type": "block",
							"children": [
								{
									"_key": "1a7cdd9ff68b",
									"_type": "span",
									"marks": [],
									"text": "Nach dem Einchecken im Hotel führte der erste Programmpunkt die Gruppe direkt zu einem Stuttgarter Wahrzeichen: dem "
								},
								{
									"_key": "1bd5cd1d048a",
									"_type": "span",
									"marks": ["c721a83973e6"],
									"text": "Fernsehturm"
								},
								{
									"_key": "517fc84aaaaa",
									"_type": "span",
									"marks": [],
									"text": ". Bei bestem Wetter bot sich aus luftiger Höhe ein beeindruckender Blick über die baden-württembergische Landeshauptstadt und die Umgebung. Am Samstagvormittag erkundeten die Jedermänner Stuttgart bei einer Stadtführung. Eine kompetente und unterhaltsame Stadtführerin brachte der Gruppe die Geschichte und Besonderheiten der Stadt näher und sorgte dabei für so manche neue Erkenntnis. Natürlich durfte auch das obligatorische Gruppenfoto nicht fehlen."
								}
							],
							"markDefs": [
								{
									"_key": "c721a83973e6",
									"_type": "externalLink",
									"href": "https://www.fernsehturm-stuttgart.de/"
								}
							],
							"style": "normal"
						},
						{
