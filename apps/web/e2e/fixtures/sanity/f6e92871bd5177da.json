								{
									"_key": "df8ac9cb92b7",
									"_type": "span",
									"marks": [],
									"text": "Fragen und Antworten"
								}
							],
							"markDefs": [],
							"style": "h2"
						},
						{
							"_key": "2a277b03525f",
							"_type": "block",
							"children": [
								{
									"_key": "7f258c796951",
									"_type": "span",
									"marks": [],
									"text": "Wie werde ich Mitglied?"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "7c2d71b65c40",
							"_type": "block",
							"children": [
								{
									"_key": "7f258c796951",
									"_type": "span",
									"marks": [],
									"text": "Einfach den ausgefüllten und unterschriebenen Aufnahmeantrag an "
								},
								{
									"_key": "77af154bd276",
									"_type": "span",
									"marks": ["strong"],
									"text": "TSG Irlich 1882 e. V., Gotenstraße 20, 56567 Neuwied"
								},
								{
									"_key": "a8bfb87dea73",
									"_type": "span",
									"marks": [],
									"text": " senden. Mitglied werden ist einfach."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "ad67dc67600f",
							"_type": "block",
							"children": [
								{
									"_key": "db383637c338",
									"_type": "span",
									"marks": [],
									"text": "Woher bekomme ich diesen Aufnahmeantrag?"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "65103325877f",
							"_type": "block",
							"children": [
								{
									"_key": "db383637c338",
									"_type": "span",
									"marks": [],
									"text": "Unsere Trainer, die Abteilungsleiter und der Vorstand halten Beitrittserklärungen für Sie bereit. Sprechen Sie uns einfach an! Der Antrag kann einfach online ausgefüllt und ausgedruckt werden."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "3ed0bff617c0",
							"_type": "block",
							"children": [
								{
									"_key": "db383637c338",
									"_type": "span",
									"marks": [],
									"text": "Wann wird der Beitrag fällig und wie kann ich ihn bezahlen?"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "1277bd557db3",
							"_type": "block",
							"children": [
								{
									"_key": "db383637c338",
									"_type": "span",
									"marks": [],
									"text": "Der Vereinsbeitrag ist jeweils zum 01.02. und 01.08. im Voraus für ein halbes Jahr zu entrichten.\nAufgrund der Satzung werden die Mitgliedsbeiträge durch das SEPA-Lastschriftverfahren eingezogen."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "d6b54f53cd40",
							"_type": "block",
							"children": [
								{
									"_key": "942bb662b219",
									"_type": "span",
									"marks": [],
									"text": "Mit dem Lastschriftverfahren steht allen ein sicheres und flexibles Verfahren zur Verfügung."
								}
							],
							"level": 1,
							"listItem": "bullet",
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "bbcf04b697dd",
							"_type": "block",
							"children": [
								{
									"_key": "942bb662b219",
									"_type": "span",
									"marks": [],
									"text": "Einer Lastschrift kann jederzeit widersprochen werden."
								}
							],
							"level": 1,
							"listItem": "bullet",
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "3233a102a998",
							"_type": "block",
							"children": [
								{
									"_key": "ee6800d19ffe",
									"_type": "span",
									"marks": [],
									"text": "Die Bankverbindung kann jederzeit geändert werden."
								}
							],
							"level": 1,
							"listItem": "bullet",
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "f39b34b8c01d",
							"_type": "block",
							"children": [
								{
									"_key": "b1885fd8adf8",
									"_type": "span",
									"marks": [],
									"text": "Abbuchungen nach Beitragsänderungen sind aktueller nachvollziehbar."
								}
							],
							"level": 1,
							"listItem": "bullet",
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "c3f87c59a1e4",
							"_type": "block",
							"children": [
								{
									"_key": "8d84cdad0e03",
									"_type": "span",
									"marks": [],
									"text": "Wann kann ich die Mitgliedschaft bei der TSG Irlich kündigen?"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "84c04d0d2916",
							"_type": "block",
							"children": [
								{
									"_key": "8d84cdad0e03",
									"_type": "span",
									"marks": [],
									"text": "Nach § 3 unserer Satzung erlischt die Mitgliedschaft durch Austritt. Die Austrittserklärung ist vom Mitglied schriftlich ("
								},
								{
									"_key": "3272d8a300bb",
									"_type": "span",
									"marks": ["strong"],
									"text": "TSG Irlich 1882 e. V., Gotenstraße 20, 56567 Neuwied"
								},
								{
									"_key": "8e508b1961a2",
									"_type": "span",
									"marks": [],
									"text": ") oder per E-Mail ("
								},
								{
									"_key": "c4ce4d0fd4fa",
									"_type": "span",
									"marks": ["953b02e5674c"],
									"text": "mitglieder@tsg-irlich.de"
								},
								{
									"_key": "55097c6f4f72",
									"_type": "span",
									"marks": [],
									"text": ") zum 30. Juni oder 31. Dezember an den Vorstand zu richten."
								}
							],
							"markDefs": [
								{
									"_key": "953b02e5674c",
									"_type": "link",
									"href": "mailto:mitglieder@tsg-irlich.de"
								}
							],
							"style": "normal"
						},
						{
							"_key": "e1118bfa5394",
							"_type": "block",
							"children": [
								{
									"_key": "55097c6f4f72",
									"_type": "span",
									"marks": [],
									"text": "Wo kann ich meine Beitrittserklärung abgeben?"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "fedb25a37e87",
							"_type": "block",
							"children": [
								{
									"_key": "55097c6f4f72",
									"_type": "span",
									"marks": [],
									"text": "Unsere Übungsleiter, Trainer, die Abteilungsleiter und der Vorstand nehmen diese gerne entgegen. Zudem gibt es am Pappelstadion den Briefkasten unserer Geschäftsstelle."
								}
