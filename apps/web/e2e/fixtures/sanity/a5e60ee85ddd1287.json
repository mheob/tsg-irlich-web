								"marks": ["4c349f1d94ad"],
								"text": "Motorik"
							},
							{
								"_key": "468cf8f66c67",
								"_type": "span",
								"marks": [],
								"text": " und den Gleichgewichtssinn zu schulen."
							}
						],
						"markDefs": [
							{
