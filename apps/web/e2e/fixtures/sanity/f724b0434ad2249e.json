				{
					"_key": "431f6379f0cd",
					"_type": "blockContent",
					"text": [
						{
							"_key": "adc985462724",
							"_type": "block",
							"children": [
								{
									"_key": "805a212b95ce",
									"_type": "span",
									"marks": [],
									"text": "Personelle Ergänzung - Die Funky Diamonds wachsen weiter"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "35a0a70f76b1",
							"_type": "block",
							"children": [
								{
									"_key": "a840bb2e80be",
									"_type": "span",
									"marks": [],
									"text": "Besonders freut uns, dass in dieser Session einige neue Gesichter erfolgreich integriert werden konnten. Aus der eigenen Nachwuchs-Tanzgruppe "
								},
								{
									"_key": "d851f3d96dcc",
									"_type": "span",
									"marks": ["strong"],
									"text": "„Magic Diamonds“"
								},
								{
									"_key": "18fcccd607cf",
									"_type": "span",
									"marks": [],
									"text": " rückten "
								},
								{
									"_key": "8f1218389986",
									"_type": "span",
									"marks": ["strong"],
									"text": "Leonie, Felix und Lara"
								},
								{
									"_key": "b5b53519df30",
									"_type": "span",
									"marks": [],
									"text": " zu den “Großen” auf und zeigten auch hier, wie viel Spaß ihnen das Tanzen macht. Als externe Neuzugänge verstärken "
								},
								{
									"_key": "0316d2108b5b",
									"_type": "span",
									"marks": ["strong"],
									"text": "Mia und Tom"
								},
								{
									"_key": "2198876436d4",
									"_type": "span",
									"marks": [],
									"text": " das Team. Ihren ersten Auftritt auf der großen Bühne meisterten sie hervorragend und freuen sich schon auf die weiteren. "
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "af389fd84566",
							"_type": "block",
							"children": [
								{
									"_key": "04adc2ddc3c0",
									"_type": "span",
									"marks": [],
									"text": "Zudem stand "
								},
								{
									"_key": "5e1f05cce689",
									"_type": "span",
									"marks": ["strong"],
									"text": "Lea"
								},
								{
									"_key": "099495ba7ef2",
									"_type": "span",
									"marks": [],
									"text": " nach über sechs Jahren Pause wieder auf der Bühne – als Springerin eingeplant, sprang sie nach nur wenig Training direkt ein und ersetzte eine erkrankte Tänzerin - mit vollem Einsatz."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "a15796e3ce36",
							"_type": "block",
							"children": [
								{
									"_key": "4a19a6ad6175",
									"_type": "span",
									"marks": [],
									"text": "Leider fällt in diesem Jahr das Funky´s-Urgestein "
								},
								{
									"_key": "8f973928441c",
									"_type": "span",
									"marks": ["strong"],
									"text": "Daniel Dinter "
								},
								{
									"_key": "4dae8d73f80f",
									"_type": "span",
									"marks": [],
									"text": "verletzungsbedingt aus, der die Gruppe im Hintergrund jedoch weiter tatkräftig unterstützt. Beim Auftritt am Samstag durfte er jedoch nicht fehlen und sorgte dafür, dass die Musik mit perfekten Timing erklang. Seine liebevollen Worte nach der gelungenen Premiere machten der Gruppe nur noch mehr Lust auf weitere Auftritte. Wir freuen uns mindestens genauso wie alle Funkys auf Daniels Comeback."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "5888a2b5cd78",
							"_type": "block",
							"children": [
								{
									"_key": "9e387194c46b",
									"_type": "span",
									"marks": [],
									"text": "Auf Grund des eher ungewöhnlich frühen Starts in die Session mussten einige Tänzerinnen private Termine absagen oder umplanen. Ohne diese Kompromisse wäre der Auftritt am ersten Januar-Wochenende nicht möglich gewesen. Das ist Einsatz - vielen Dank an dieser Stelle!"
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
