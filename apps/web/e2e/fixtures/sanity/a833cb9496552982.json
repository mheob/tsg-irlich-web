					"text": [
						{
							"_key": "48487660ca99",
							"_type": "block",
							"children": [
								{
									"_key": "9173b9cf7315",
									"_type": "span",
									"marks": ["strong", "em"],
									"text": "Am Mittwoch, den 5. August 2026, hieß es für die Mittwochsgirls der TSG Irlich wieder: Gemeinsam unterwegs sein und einen schönen Tag miteinander verbringen! Wie in jedem Jahr stand eine gemeinsame Tagestour auf dem Programm – diesmal ging es an die Mosel nach Cochem."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "72aa47777198",
							"_type": "block",
							"children": [
								{
									"_key": "10e945bb43e1",
									"_type": "span",
									"marks": [],
									"text": "Der Tag begann bereits am Morgen mit der Fahrt im Schienenersatzverkehr nach Koblenz. Dort angekommen wartete zunächst ein gemeinsames Frühstück auf die Gruppe. Frische belegte Brötchen sorgten für einen guten Start in den Tag und natürlich durfte auch der obligatorische Sekt nicht fehlen."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "df109b606c1e",
							"_type": "block",
							"children": [
								{
									"_key": "f219c9549f39",
									"_type": "span",
									"marks": [],
									"text": "Auf Entdeckungstour durch Cochem"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "c2aa3acb0fbd",
							"_type": "block",
							"children": [
								{
									"_key": "3dbb0f693dcd",
									"_type": "span",
									"marks": [],
									"text": "Anschließend ging es weiter nach "
								},
								{
									"_key": "717445e75586",
									"_type": "span",
									"marks": ["9bbeb56d7631"],
									"text": "Cochem"
								},
								{
									"_key": "8434511e91aa",
									"_type": "span",
									"marks": [],
									"text": ". Cochem ist mit rund 5000 Einwohnern die Kreisstadt des Kreises Cochem-Zell und damit die "
								},
								{
									"_key": "79b76a1e2abc",
									"_type": "span",
									"marks": ["strong"],
									"text": "kleinste Kreisstadt in Deutschland"
								},
								{
									"_key": "60f7e43e5c15",
									"_type": "span",
									"marks": [],
									"text": ". Das Erstaunen über diese Tatsache ist oft groß, denn durch die zahlreichen Besucher und Touristen und die vielen Hotels und Einzelhandelsgeschäfte wirkt das beschauliche Städtchen an der Untermpsel eigentlich sehr viel größer und weitläufiger."
								}
							],
							"markDefs": [
								{
									"_key": "9bbeb56d7631",
									"_type": "externalLink",
									"href": "https://cochem.de/"
								}
							],
							"style": "normal"
						},
						{
							"_key": "555c5af51a01",
							"_type": "block",
							"children": [
								{
									"_key": "8434511e91aa",
									"_type": "span",
									"marks": [],
									"text": "Bei einer unterhaltsamen "
								},
								{
									"_key": "06b09e888c16",
									"_type": "span",
									"marks": ["strong"],
									"text": "Stadtführung"
								},
								{
									"_key": "13ed6fb3c3d2",
									"_type": "span",
									"marks": [],
									"text": " konnten die Mittwochsgirls die schöne Moselstadt näher kennenlernen und dabei sicher auch die eine oder andere neue Facette entdecken."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "5a2902289506",
					"_type": "mainImage",
					"alt": "Die Mittwochsgirls bei ihrer Stadtrundführung wie sie dem Guide gebannt zuhören",
					"asset": {
						"_ref": "image-6ad29225ab04f7311c6f62a3e7a19f69231a66d3-5184x3888-jpg",
						"_type": "reference"
					}
				},
				{
					"_key": "3c7cda99d1bb",
					"_type": "blockContent",
					"text": [
						{
							"_key": "8e3a09c7326c",
							"_type": "block",
							"children": [
								{
									"_key": "4510a4029441",
									"_type": "span",
									"marks": [],
									"text": "Eine Überraschung auf der Mosel"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "268435384c22",
							"_type": "block",
							"children": [
								{
									"_key": "0cf78f5b5cb6",
									"_type": "span",
									"marks": [],
									"text": "Danach wartete bereits der nächste Programmpunkt – und der war für die Teilnehmerinnen eine echte Überraschung: Eine "
								},
								{
									"_key": "f23635a2da44",
									"_type": "span",
									"marks": ["strong"],
									"text": "Panoramafahrt"
								},
								{
									"_key": "6e0e1609231e",
									"_type": "span",
									"marks": [],
									"text": " mit dem Schiff auf der Mosel! Bei einem herrlichen Ausblick auf die Landschaft und die Weinberge ließen es sich die Mittwochsgirls gut gehen und genossen die gemeinsame Zeit. Die Überraschung kam bei allen bestens an und sorgte für viel Freude und gute Stimmung."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "4fac559c77b7",
					"_type": "mainImage",
					"alt": "Ein Schiff auf der Mosel",
					"asset": {
						"_ref": "image-2c0be31ad7b37fdc19e82a419dd535518b9d7346-5184x3888-jpg",
						"_type": "reference"
					}
				},
				{
					"_key": "dc6fb3f8c41d",
