							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "a1167350b576",
							"_type": "block",
							"children": [
								{
									"_key": "f94b5b755e6a",
									"_type": "span",
									"marks": [],
									"text": "Trotz der schwierigen Ausgangslage gab sich die TSG keineswegs geschlagen. Nach dem Seitenwechsel erhöhte die Mannschaft den Druck und nahm die Zweikämpfe noch entschlossener an. Die TSG zeigte nun die passende Reaktion und arbeitete sich mit viel Einsatz zurück in die Partie."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "a2aa380300e1",
							"_type": "block",
							"children": [
								{
									"_key": "9e5bd7e99a96",
									"_type": "span",
									"marks": [],
									"text": "In der 63. Minute belohnte sich Irlich für die Leistungssteigerung. Außenbahnspieler "
								},
								{
									"_key": "360d44e4885d",
									"_type": "span",
									"marks": ["strong"],
									"text": "Julius Petry"
								},
								{
									"_key": "9ce07a35addc",
									"_type": "span",
									"marks": [],
									"text": " erzielte den wichtigen Anschlusstreffer zum 2:3 und sorgte damit dafür, dass die Partie endgültig wieder offen war."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "967e7aa5b994",
							"_type": "block",
							"children": [
								{
									"_key": "4cfb11c2bd18",
									"_type": "span",
									"marks": [],
									"text": "Der Treffer gab der Mannschaft weiteren Auftrieb. Nur fünf Minuten später gelang der TSG tatsächlich der Ausgleich: "
								},
								{
									"_key": "983dad583318",
									"_type": "span",
									"marks": ["strong"],
									"text": "Mehmet Capkur"
								},
								{
									"_key": "95265e5a266e",
									"_type": "span",
									"marks": [],
									"text": " traf in der 68. Minute zum 3:3 und brachte das Pappelstadion zum Jubeln. Die Mannschaft gab sich mit dem Unentschieden jedoch nicht zufrieden und drängte auf das nächste Tor."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "b5d7099c9cb3",
					"_type": "blockContent",
					"text": [
						{
							"_key": "4fc9ded8dbf3",
							"_type": "block",
							"children": [
								{
									"_key": "28ad99320e33",
									"_type": "span",
									"marks": ["strong"],
									"text": "Marschke entscheidet das Spiel per Freistoß"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "824c41f5f025",
							"_type": "block",
							"children": [
								{
									"_key": "5257d7646e2d",
									"_type": "span",
									"marks": [],
									"text": "In der Schlussphase blieb die Begegnung hart umkämpft. Beide Mannschaften investierten viel und führten die Zweikämpfe mit großer Intensität. Den entscheidenden Moment hatte schließlich die TSG."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "71468d443ee1",
							"_type": "block",
							"children": [
								{
									"_key": "c33f76a92fa3",
									"_type": "span",
									"marks": [],
									"text": "Co-Kapitän "
								},
								{
									"_key": "dd1678cb5885",
									"_type": "span",
									"marks": ["strong"],
									"text": "Dennis Marschke"
								},
								{
									"_key": "b706cae7eda0",
									"_type": "span",
									"marks": [],
									"text": " übernahm bei einem Freistoß die Verantwortung und verwandelte diesen zum viel umjubelten "
								},
								{
									"_key": "1b9cbb63a069",
									"_type": "span",
									"marks": ["strong"],
									"text": "4:3"
								},
								{
									"_key": "a8d94c78300a",
									"_type": "span",
									"marks": [],
									"text": ". "
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "d1fdde826e46",
							"_type": "block",
							"children": [
								{
									"_key": "dc475d55d1df",
									"_type": "span",
									"marks": [],
									"text": "In den verbleibenden Minuten verteidigte die TSG die Führung mit großem Einsatz. Gemeinsam brachte die Mannschaft den knappen Vorsprung über die Zeit und belohnte sich für eine beeindruckende zweite Halbzeit mit drei wichtigen Punkten gegen das Top-Team von der anderen Rhein-Seite."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
