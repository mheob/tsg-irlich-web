					"text": [
						{
							"_key": "cfd37f858137",
							"_type": "block",
							"children": [
								{
									"_key": "ed6e3a49d670",
									"_type": "span",
									"marks": [],
									"text": "Die TSG Irlich hat am vierten Spieltag der Kreisliga C einen echten Kraftakt vollbracht. Gegen die bis dahin noch ungeschlagene "
								},
								{
									"_key": "034b9563e4d8",
									"_type": "span",
									"marks": ["strong"],
									"text": "SG Weißenthurm II"
								},
								{
									"_key": "7d8fb5973df6",
									"_type": "span",
									"marks": [],
									"text": " drehte die #11fürIrlich einen "
								},
								{
									"_key": "a5ea745d1679",
									"_type": "span",
									"marks": ["strong"],
									"text": "1:3-Halbzeitrückstand "
								},
								{
									"_key": "18f633449593",
									"_type": "span",
									"marks": [],
									"text": "und feierte vor heimischer Kulisse einen umjubelten "
								},
								{
									"_key": "f548117e3b4e",
									"_type": "span",
									"marks": ["strong"],
									"text": "4:3-Erfolg"
								},
								{
									"_key": "2a71efd9d865",
									"_type": "span",
									"marks": [],
									"text": ". In einem intensiven Spiel mit viel Körperkontakt und zahlreichen Zweikämpfen bewies die Mannschaft große Moral. Den entscheidenden Treffer erzielte Co-Kapitän "
								},
								{
									"_key": "4b41289e06f0",
									"_type": "span",
									"marks": ["strong"],
									"text": "Dennis Marschke"
								},
								{
									"_key": "b710d137ecbb",
									"_type": "span",
									"marks": [],
									"text": " mit einem Freistoß."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "61449bf4178b",
					"_type": "blockContent",
					"text": [
						{
							"_key": "316462e12625",
							"_type": "block",
							"children": [
								{
									"_key": "4bfaf50bf8ad",
									"_type": "span",
									"marks": ["strong"],
									"text": "Frühe Führung durch Dennis Kari"
								}
							],
							"markDefs": [],
							"style": "h3"
						},
						{
							"_key": "db0fc0179993",
							"_type": "block",
							"children": [
								{
									"_key": "27975471ba5f",
									"_type": "span",
									"marks": [],
									"text": "Die TSG erwischte einen Start nach Maß und ging bereits in der 6. Minute in Führung. "
								},
								{
									"_key": "92b1ded0955c",
									"_type": "span",
									"marks": ["strong"],
									"text": "Dennis Kari"
								},
								{
									"_key": "54331db2a763",
									"_type": "span",
									"marks": [],
									"text": " brachte die Irlicher mit seinem Treffer zum 1:0 früh auf Kurs."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "2002a3042f5d",
							"_type": "block",
							"children": [
								{
									"_key": "de07df53af90",
									"_type": "span",
									"marks": [],
									"text": "Die Gäste ließen sich von dem Rückstand allerdings nicht aus der Ruhe bringen und fanden zunehmend besser in die Begegnung. In der 16. Minute erzielte "
								},
								{
									"_key": "9993a1e4b588",
									"_type": "span",
									"marks": ["strong"],
									"text": "Meron Rezene"
								},
								{
									"_key": "e557ab3b80ae",
									"_type": "span",
									"marks": [],
									"text": " den Ausgleich zum 1:1. Anschließend entwickelte sich die erwartet umkämpfte Partie. Beide Mannschaften schenkten sich in den Zweikämpfen nichts und suchten immer wieder den direkten Weg nach vorne."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "448bf2a1c833",
							"_type": "block",
							"children": [
								{
									"_key": "d31823194aad",
									"_type": "span",
									"marks": [],
									"text": "In dieser Phase präsentierte sich Weißenthurm vor dem Tor konsequenter. "
								},
								{
									"_key": "65c23f428bfd",
									"_type": "span",
									"marks": ["strong"],
									"text": "Bedirhan Tekin"
								},
								{
									"_key": "919c14954249",
									"_type": "span",
									"marks": [],
									"text": " drehte das Spiel in der 25. Minute mit seinem Treffer zum 1:2. Nur sieben Minuten später erhöhte "
								},
								{
									"_key": "0d22dec33d5b",
									"_type": "span",
									"marks": ["strong"],
									"text": "Karim Hassanin"
								},
								{
									"_key": "e388f43dedf4",
									"_type": "span",
									"marks": [],
									"text": " auf 1:3."
								}
							],
							"markDefs": [],
							"style": "normal"
						},
						{
							"_key": "9deb36cc914e",
							"_type": "block",
							"children": [
								{
									"_key": "ccec5798081d",
									"_type": "span",
									"marks": [],
									"text": "Innerhalb kurzer Zeit hatte die TSG ihre frühe Führung aus der Hand gegeben. Bis zur Pause gelang es der Mannschaft nicht mehr, den Rückstand zu verkürzen. So ging es nach einer intensiven ersten Halbzeit mit einem 1:3 in die Kabinen."
								}
							],
							"markDefs": [],
							"style": "normal"
						}
					]
				},
				{
					"_key": "a711bf394650",
					"_type": "blockquote",
					"author": "Co-Trainer Andy Pung",
					"quote": "Nach dem 1:3 zur Halbzeit war klar, dass wir in der zweiten Hälfte eine deutliche Reaktion zeigen müssen."
				},
				{
					"_key": "713a3f3e0c37",
					"_type": "mainImage",
					"alt": "Umkämpftes Duell: Bastian Kindler haut im Zweikampf alles rein",
