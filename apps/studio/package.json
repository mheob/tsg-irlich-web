		"@sanity/vision": "catalog:",
		"@tsgi-web/shared": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-icons": "catalog:",
		"sanity": "catalog:",
		"sanity-plugin-media": "catalog:",
		"slugify": "catalog:",
		"styled-components": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tsgi-web/pdf-pages": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
