{
	"name": "studio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "sanity build",
		"deploy": "sanity deploy",
		"deploy:graphql": "sanity graphql deploy",
		"deploy:schema": "sanity schema deploy",
		"dev": "sanity dev",
		"extract-types": "sanity schema extract --enforce-required-fields --force",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"lint:github": "vp lint --format=github",
		"start": "sanity start",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"test:watch": "vp test",
		"typecheck": "tsc --noEmit --incremental false"
	},
	"dependencies": {
		"@sanity/assist": "catalog:",
		"@sanity/icons": "catalog:",
		"@sanity/locale-de-de": "catalog:",
