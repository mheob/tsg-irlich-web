# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
ignore:
  SNYK-JS-MINIMATCH-22111072:
    - '*':
        reason: >-
          minimatch is only fixed in 11.0.1, a major release react-email has not moved to yet, and
          the flaw needs a crafted glob pattern parsed with optimizationLevel 2 or higher. 10.2.6
          reaches this package only through glob below the react-email CLI, which lists the
          template folder for its preview and export commands; rendering a mail with
          @react-email/render never touches it. Revisit once react-email moves to minimatch 11.
        expires: 2026-12-01T00:00:00.000Z
patch: {}
