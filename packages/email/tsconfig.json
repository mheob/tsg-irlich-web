{
	"compilerOptions": {
		"composite": false,
		"jsx": "react-jsx",
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", ".react-email"]
}
