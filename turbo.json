{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"E2E_MOCK",
		"NEXT_PUBLIC_SANITY_API_VERSION",
		"NEXT_PUBLIC_SANITY_DATASET",
		"NEXT_PUBLIC_SANITY_PROJECT_ID",
		"NEXT_PUBLIC_SANITY_STUDIO_URL",
		"LINEAR_API_KEY",
		"LINEAR_ASSIGNEE_ID",
		"LINEAR_LABEL_ID",
		"LINEAR_TEAM_ID",
		"RESEND_API_KEY",
		"SANITY_API_READ_TOKEN",
		"SANITY_REVALIDATE_SECRET",
		"VERCEL_OIDC_TOKEN",
		"VERCEL_PROJECT_PRODUCTION_URL"
	],
	"tasks": {
		"@tsgi-web/email#build": {
			"env": [
				"CLEVERREACH_CLIENT_ID",
				"CLEVERREACH_CLIENT_SECRET",
				"CLEVERREACH_FORM_ID",
				"CLEVERREACH_LIST_ID"
			]
		},
		"build": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:email": {
			"cache": false,
			"persistent": true
		},
		"extract-types": {},
		"lint": {},
		"lint:fix": {},
		"lint:github": {},
		"studio#build": {
			"dependsOn": ["^build"],
			"env": [
				"SANITY_API_DATASET",
				"SANITY_API_PROJECT_ID",
				"SANITY_API_READ_TOKEN",
				"SANITY_API_VERSION",
				"SANITY_API_WRITE_TOKEN",
				"SANITY_STUDIO_DATASET",
				"SANITY_STUDIO_PREVIEW_URL",
				"SANITY_STUDIO_PROJECT_ID",
				"VERCEL_OIDC_TOKEN"
			],
			"outputs": ["dist/**"]
		},
		"test": {},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build"],
			"env": ["E2E_RECORD", "E2E_REUSE_SERVER", "PLAYWRIGHT_BASE_URL"],
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"test:coverage": {
			"outputs": ["coverage/**"]
		},
		"typecheck": {},
		"typegen:routes": {},
		"typegen:sanity": {
			"dependsOn": ["studio#extract-types"]
		},
		"web#build": {
			"env": [
				"CLEVERREACH_CLIENT_ID",
				"CLEVERREACH_CLIENT_SECRET",
				"CLEVERREACH_FORM_ID",
				"CLEVERREACH_LIST_ID"
			],
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**"]
		}
	}
}
